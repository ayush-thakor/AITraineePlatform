    {
      "id": "customFunctionAgentflow_0",
      "type": "agentFlow",
      "position": { "x": 300, "y": 120 },
      "data": {
        "id": "customFunctionAgentflow_0",
        "label": "Normalize Deadline",
        "version": 1,
        "name": "customFunctionAgentflow",
        "type": "CustomFunction",
        "color": "#E4B7FF",
        "baseClasses": ["CustomFunction"],
        "category": "Agent Flows",
        "description": "Extract and validate the escalation deadline",
        "inputParams": [
          {
            "label": "Input Variables",
            "name": "customFunctionInputVariables",
            "type": "array",
            "optional": true,
            "acceptVariable": true,
            "array": [
              { "label": "Variable Name", "name": "variableName", "type": "string" },
              { "label": "Variable Value", "name": "variableValue", "type": "string", "acceptVariable": true }
            ],
            "id": "customFunctionAgentflow_0-input-customFunctionInputVariables-array",
            "display": true
          },
          {
            "label": "Javascript Function",
            "name": "customFunctionJavascriptFunction",
            "type": "code",
            "id": "customFunctionAgentflow_0-input-customFunctionJavascriptFunction-code",
            "display": true
          },
          {
            "label": "Update Flow State",
            "name": "customFunctionUpdateState",
            "type": "array",
            "optional": true,
            "acceptVariable": true,
            "array": [
              { "label": "Key", "name": "key", "type": "string" },
              { "label": "Value", "name": "value", "type": "string", "acceptVariable": true }
            ],
            "id": "customFunctionAgentflow_0-input-customFunctionUpdateState-array",
            "display": true
          }
        ],
        "inputAnchors": [],
        "inputs": {
          "customFunctionInputVariables": "",
          "customFunctionJavascriptFunction": "function asText(value) {\n  if (value === null || value === undefined) return '';\n  if (typeof value === 'string') return value;\n  try {\n    return JSON.stringify(value);\n  } catch (_error) {\n    return String(value);\n  }\n}\n\nfunction compact(value) {\n  return typeof value === 'string' && value.trim() ? value.trim() : '';\n}\n\nconst rawInput = $flow.input;\nlet parsedInput = {};\n\nif (rawInput && typeof rawInput === 'object' && !Array.isArray(rawInput)) {\n  parsedInput = rawInput;\n} else {\n  try {\n    const maybeJson = JSON.parse(asText(rawInput));\n    if (maybeJson && typeof maybeJson === 'object' && !Array.isArray(maybeJson)) {\n      parsedInput = maybeJson;\n    }\n  } catch (_error) {}\n}\n\nconst inputText = asText(rawInput);\nconst candidates = [\n  parsedInput.deadline,\n  parsedInput.date,\n  parsedInput.dueDate,\n  parsedInput.trainingDeadline,\n  parsedInput.input,\n  inputText\n].map(compact).filter(Boolean);\n\nlet deadline = '';\nfor (const candidate of candidates) {\n  const exact = candidate.match(/^\\d{4}-\\d{2}-\\d{2}$/);\n  const embedded = candidate.match(/\\b\\d{4}-\\d{2}-\\d{2}\\b/);\n  if (exact || embedded) {\n    deadline = (exact || embedded)[0];\n    break;\n  }\n}\n\nif (!deadline) {\n  return JSON.stringify({\n    error: 'Missing deadline. Run the flow with a deadline in YYYY-MM-DD format.',\n    example: '2026-05-25'\n  });\n}\n\nconst normalizedDate = new Date(`${deadline}T00:00:00.000Z`);\nif (Number.isNaN(normalizedDate.getTime())) {\n  return JSON.stringify({\n    error: `Invalid deadline date: ${deadline}`,\n    example: '2026-05-25'\n  });\n}\n\nreturn JSON.stringify({\n  deadline: normalizedDate.toISOString().slice(0, 10)\n});",
          "customFunctionUpdateState": ""
        },
        "outputAnchors": [
          {
            "id": "customFunctionAgentflow_0-output-customFunctionAgentflow",
            "label": "Custom Function",
            "name": "customFunctionAgentflow"
          }
        ],
        "outputs": {},
        "selected": false
      },
      "width": 210,
      "height": 66,
      "selected": false,
      "positionAbsolute": { "x": 300, "y": 120 },
