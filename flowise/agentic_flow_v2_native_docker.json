      "data": {
        "id": "customFunctionAgentflow_1",
        "label": "Format Summary",
        "version": 1,
        "name": "customFunctionAgentflow",
        "type": "CustomFunction",
        "color": "#E4B7FF",
        "baseClasses": ["CustomFunction"],
        "category": "Agent Flows",
        "description": "Format the proxy result for the manager",
        "inputParams": [
          {
            "label": "Input Variables",
            "name": "customFunctionInputVariables",
            "type": "array",
            "optional": true,
            "acceptVariable": true,
            "array": [
              { "label": "Variable Name", "name": "variableName", "type": "string" },
              { "label": "Variable Value", "name": "variableValue", "type": "string", "acceptVariable": true }
            ],
